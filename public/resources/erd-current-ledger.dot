digraph Workbench { graph [rankdir=LR, bgcolor="white", pad=.5, nodesep=.65, ranksep=1.3, splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=24, labelloc=t, label="Ledger, frozen assessments and investigation | All columns\nPK primary key   FK foreign key   UK unique key   ! required column\nNumbers describe database constraints, not process order"]; node [shape=plain, fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12, color="#7c919c", penwidth=1.4, labelangle=25]; "customers" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(150) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">id_number</TD><TD ALIGN="LEFT">varchar(20) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">kyc_status</TD><TD ALIGN="LEFT">varchar(20) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
"accounts" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">account_type</TD><TD ALIGN="LEFT">varchar(30) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">balance</TD><TD ALIGN="LEFT">numeric(15,2) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">opened_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
"transactions" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">numeric(15,2) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">char(3) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">merchant</TD><TD ALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">tx_date</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">tx_type</TD><TD ALIGN="LEFT">varchar(30) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">cross_border</TD><TD ALIGN="LEFT">boolean !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">raw_file</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_system</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_transaction_id</TD><TD ALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">transaction_fingerprint</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">file_sha256</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_row</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT">char(2)</TD></TR></TABLE>>];
"processed_transactions" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>processed_transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK/FK</FONT></TD><TD ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">char(64) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT">jsonb !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">processed_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
