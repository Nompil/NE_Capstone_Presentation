"alerts" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#785996"><FONT COLOR="white"><B>alerts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">alert_id</TD><TD ALIGN="LEFT">bigint !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">risk_event_id</TD><TD ALIGN="LEFT">bigint !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT">varchar(20) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">sent_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">delivery_key</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">delivery_state</TD><TD ALIGN="LEFT">varchar(10) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">provider_message_id</TD><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"customers" -> "accounts" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (customer_id) REFERENCES customers(customer_id) ON DELETE RESTRICT", labeldistance=1.9];
"risk_events" -> "alerts" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (risk_event_id) REFERENCES risk_events(risk_event_id)", labeldistance=1.9];
