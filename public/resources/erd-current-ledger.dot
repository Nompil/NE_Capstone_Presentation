"risk_events" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#785996"><FONT COLOR="white"><B>risk_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">risk_event_id</TD><TD ALIGN="LEFT">bigint !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">risk_score</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
"risk_reviews" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#785996"><FONT COLOR="white"><B>risk_reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK/FK</FONT></TD><TD ALIGN="LEFT">risk_event_id</TD><TD ALIGN="LEFT">bigint !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">review_status</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reviewer_subject</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reviewed_by</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">review_notes</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">resolution_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">change_actor</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">change_request_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">request_digest</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
