digraph Workbench { graph [rankdir=LR, bgcolor="white", pad=.5, nodesep=.65, ranksep=1.3, splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=24, labelloc=t, label="Ingestion, quarantine and correction | All columns\nPK primary key   FK foreign key   UK unique key   ! required column\nNumbers describe database constraints, not process order"]; node [shape=plain, fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12, color="#7c919c", penwidth=1.4, labelangle=25]; "transactions" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">tx_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">numeric(15,2) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">char(3) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">merchant</TD><TD ALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">tx_date</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">tx_type</TD><TD ALIGN="LEFT">varchar(30) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">cross_border</TD><TD ALIGN="LEFT">boolean !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">raw_file</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_system</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_transaction_id</TD><TD ALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">transaction_fingerprint</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">file_sha256</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_row</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT">char(2)</TD></TR></TABLE>>];
"ingestion_batches" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#287b78"><FONT COLOR="white"><B>ingestion_batches</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_system</TD><TD ALIGN="LEFT">varchar(100) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">source_bucket</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">file_sha256</TD><TD ALIGN="LEFT">char(64) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">rows_received</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">publication_complete</TD><TD ALIGN="LEFT">boolean !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">file_failure_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UK (source_bucket, file_sha256)</FONT></TD></TR></TABLE>>];
"ingestion_attempts" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#287b78"><FONT COLOR="white"><B>ingestion_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK/UK</FONT></TD><TD ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_bucket</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_file</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_version</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_etag</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UK (batch_id, attempt_id)</FONT></TD></TR></TABLE>>];
"ingestion_records" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#287b78"><FONT COLOR="white"><B>ingestion_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK/FK</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">source_row</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">source_attempt_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">disposition</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">candidate_digest</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">canonical_tx_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reason_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">PK (batch_id, source_row)</FONT></TD></TR></TABLE>>];
"transaction_lifecycle_events" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#287b78"><FONT COLOR="white"><B>transaction_lifecycle_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">bigint !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">source_row</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">sequence</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">actor_subject</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">error_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UK (batch_id, source_row, sequence)</FONT></TD></TR></TABLE>>];
"quarantine_cases" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b16e37"><FONT COLOR="white"><B>quarantine_cases</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">quarantine_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">source_row</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reason_code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">reason_detail</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">validation_errors</TD><TD ALIGN="LEFT">jsonb !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">candidate_account_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">safe_payload_key</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">safe_payload_version</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">source_reference</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">quarantined_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UK (batch_id, source_row)</FONT></TD></TR></TABLE>>];
"quarantine_corrections" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b16e37"><FONT COLOR="white"><B>quarantine_corrections</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">correction_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK/UK</FONT></TD><TD ALIGN="LEFT">quarantine_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">request_digest</TD><TD ALIGN="LEFT">char(64)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">UK</FONT></TD><TD ALIGN="LEFT">correction_version</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">submitted_by</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">submitted_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">correction_notes</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">corrected_payload_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">corrected_payload_version</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">reprocess_batch_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">reprocess_source_row</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UK (quarantine_id, correction_version)</FONT></TD></TR></TABLE>>];
"correction_outbox" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b16e37"><FONT COLOR="white"><B>correction_outbox</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK/FK</FONT></TD><TD ALIGN="LEFT">correction_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">envelope</TD><TD ALIGN="LEFT">jsonb !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">last_error_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
"quarantine_corrections" -> "correction_outbox" [dir=none, taillabel="1", headlabel="0..1", tooltip="FOREIGN KEY (correction_id) REFERENCES quarantine_corrections(correction_id)", labeldistance=1.9];
"ingestion_batches" -> "ingestion_attempts" [dir=none, taillabel="0..1", headlabel="0..*", tooltip="FOREIGN KEY (batch_id) REFERENCES ingestion_batches(batch_id)", labeldistance=1.9];
"ingestion_batches" -> "ingestion_records" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (batch_id) REFERENCES ingestion_batches(batch_id)", labeldistance=1.9];
"ingestion_attempts" -> "ingestion_records" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (batch_id, source_attempt_id) REFERENCES ingestion_attempts(batch_id, attempt_id)", labeldistance=1.9];
"transactions" -> "ingestion_records" [dir=none, taillabel="0..1", headlabel="0..*", tooltip="FOREIGN KEY (canonical_tx_id) REFERENCES transactions(tx_id)", labeldistance=1.9];
"ingestion_records" -> "quarantine_cases" [dir=none, taillabel="1", headlabel="0..1", tooltip="FOREIGN KEY (batch_id, source_row) REFERENCES ingestion_records(batch_id, source_row)", labeldistance=1.9];
"quarantine_cases" -> "quarantine_corrections" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (quarantine_id) REFERENCES quarantine_cases(quarantine_id)", labeldistance=1.9];
"ingestion_records" -> "quarantine_corrections" [dir=none, taillabel="0..1", headlabel="0..*", tooltip="FOREIGN KEY (reprocess_batch_id, reprocess_source_row) REFERENCES ingestion_records(batch_id, source_row)", labeldistance=1.9];
"ingestion_records" -> "transaction_lifecycle_events" [dir=none, taillabel="1", headlabel="0..*", tooltip="FOREIGN KEY (batch_id, source_row) REFERENCES ingestion_records(batch_id, source_row)", labeldistance=1.9];
}