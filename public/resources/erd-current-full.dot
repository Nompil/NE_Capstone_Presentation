digraph Workbench { graph [rankdir=LR, bgcolor="white", pad=.5, nodesep=.65, ranksep=1.3, splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=24, labelloc=t, label="Imbokodo Risk and Compliance Workbench | Full physical ERD | 18 tables\nPK primary key   FK foreign key   UK unique key   ! required column\nNumbers describe database constraints, not process order"]; node [shape=plain, fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12, color="#7c919c", penwidth=1.4, labelangle=25]; "accounts" [label=<<TABLE BORDER="1" COLOR="#b7c7cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#345e8c"><FONT COLOR="white"><B>accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">PK</FONT></TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">FK</FONT></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">account_type</TD><TD ALIGN="LEFT">varchar(30) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">balance</TD><TD ALIGN="LEFT">numeric(15,2) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) !</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#345e8c">&#160;</FONT></TD><TD ALIGN="LEFT">opened_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR></TABLE>>];
